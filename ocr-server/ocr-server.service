[Unit]
Description=Surya OCR Server
After=network.target

[Service]
Type=simple
# --- Replace /path/to/local-ai-search with your actual install path ---
WorkingDirectory=/path/to/local-ai-search/ocr-server
ExecStart=/path/to/local-ai-search/ocr-server/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8090

# Surya v2 runs recognition in llama-server (GPU via Vulkan/CUDA/Metal build).
# torch is only used on CPU.
Environment=TORCH_DEVICE=cpu
Environment=SURYA_INFERENCE_BACKEND=llamacpp
# Path to a llama-server binary built with GPU support (defaults to PATH lookup)
#Environment=LLAMA_CPP_BINARY=/path/to/llama.cpp/build/bin/llama-server
Environment=PATH=/path/to/local-ai-search/ocr-server/venv/bin:/usr/local/bin:/usr/bin:/bin
# Startup waits for llama-server to load the model
TimeoutStartSec=660

# Auto-restart on crash
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
